{
 "app": "customer",
 "route": "code",
 "functions": [
  {
   "id": "otp",
   "kind": "form",
   "users": [
    "us",
    "in"
   ],
   "action": "Enter the 6-digit code",
   "expected": "Signed in",
   "verify": "UI",
   "run": "maestro: apps/customer/.maestro/sign-in-email.yaml",
   "maestro": "sign-in-email"
  },
  {
   "id": "wrong-code",
   "kind": "error",
   "users": [
    "us",
    "in"
   ],
   "action": "A wrong code, then the right one",
   "expected": "Refused with a message; the right code signs in",
   "verify": "UI",
   "run": "maestro: apps/customer/.maestro/r43-wrong-code-{user}.yaml",
   "maestro": "r43-wrong-code-{user}"
  },
  {
   "id": "na-permission",
   "kind": "permission",
   "na": "the way in: anyone may open it"
  },
  {
   "id": "na-empty",
   "kind": "empty",
   "na": "a form"
  }
 ]
}
