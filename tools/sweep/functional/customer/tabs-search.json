   "run": "maestro: apps/customer/.maestro/tabbar-clearance.yaml",
   "maestro": "tabbar-clearance"
  },
  {
   "id": "nothing-found",
   "kind": "empty",
   "users": [
    "us",
    "in"
   ],
   "action": "Search nonsense",
   "expected": "'Nothing found'",
   "verify": "UI",
   "run": "not automated yet (NOT RUN)",
   "test": "none"
  },
  {
   "id": "api-down",
   "kind": "error",
   "users": [
    "us",
    "in"
   ],
   "action": "Open it with core-api stopped",
