{
 "app": "customer",
 "route": "(tabs)/search",
 "functions": [
  {
   "id": "search",
   "kind": "filter",
   "users": [
    "us",
    "in"
   ],
   "action": "Search 'curry'",
   "expected": "Restaurants and dishes matching",
   "verify": "UI vs /search",
   "run": "maestro: apps/customer/.maestro/r36-search-curry.yaml",
   "maestro": "r36-search-curry"
  },
  {
   "id": "tabbar",
   "kind": "navigation",
   "users": [
    "us",
    "in"
   ],
