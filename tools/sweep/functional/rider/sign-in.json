{
 "app": "rider",
 "route": "sign-in",
 "functions": [
  {
   "id": "email",
   "kind": "form",
   "users": [
    "us",
    "in"
   ],
   "action": "Email sign-in",
   "expected": "Signed in",
   "verify": "UI",
   "run": "maestro: apps/rider/.maestro/sign-in-email.yaml",
