   "verify": "UI",
   "run": "maestro: apps/rider/.maestro/r42-wrong-role.yaml",
   "maestro": "r42-wrong-role"
  },
  {
   "id": "phone",
   "kind": "form",
   "users": [
    "us",
    "in"
   ],
   "action": "Phone sign-in",
   "expected": "Signed in",
   "verify": "UI",
   "run": "maestro: apps/rider/.maestro/r39-phone.yaml",
   "maestro": "r39-phone"
  },
  {
   "id": "api-down",
   "kind": "error",
   "users": [
    "us",
    "in"
   ],
   "action": "Open it with core-api stopped",
