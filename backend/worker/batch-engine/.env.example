# ── Batch Engine ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8007
LOG_LEVEL=info

# Database (shared PostgreSQL, batch_engine schema)
DATABASE_URL=postgresql://bhojango:bhojango_dev@localhost:5432/bhojango

# Redis (for future driver location cache)
REDIS_URL=redis://localhost:6379/6

# AWS (LocalStack in dev)
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
SNS_TOPIC_ARN_BATCH=arn:aws:sns:us-east-1:000000000000:bhojango-batch-events
SQS_QUEUE_URL_BATCH=http://localhost:4566/000000000000/bhojango-batch-events

# ── Engine Tuning ────────────────────────────────────────────────────────────
BATCH_CYCLE_SECONDS=30
MAX_ORDERS_PER_BATCH=3
MAX_PICKUP_RADIUS_KM=1.5
MAX_DELIVERY_RADIUS_KM=3.0
MAX_DETOUR_MINUTES=8
MAX_EXTRA_DELAY_MINUTES=5
MAX_WAIT_IN_POOL_MINUTES=5
MIN_SAVINGS_PERCENT=15
PRIORITY_ORDER_BATCHABLE=false
AVERAGE_SPEED_KMH=25
