# Copy to .env.local for `pnpm dev` (in Docker, `make dev` sets these for you).
# Next.js proxies /api/<area>/* to core_api; there is no gateway.
USER_SVC_URL=http://localhost:8001
RESTAURANT_SVC_URL=http://localhost:8001
ORDER_SVC_URL=http://localhost:8001
PAYMENT_SVC_URL=http://localhost:8001
# The browser connects to realtime directly for live tracking.
NEXT_PUBLIC_WS_URL=ws://localhost:8004
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
