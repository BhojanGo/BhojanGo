# Copy to .env (git-ignored). The app calls the backend directly; there is no gateway.
# On a phone or emulator "localhost" is the device itself, so use your computer's
# LAN IP (e.g. 192.168.1.20), or 10.0.2.2 on the Android emulator.
EXPO_PUBLIC_API_URL=http://192.168.1.20:8001/api/v1
EXPO_PUBLIC_REALTIME_URL=http://192.168.1.20:8004/api/v1
EXPO_PUBLIC_WS_URL=ws://192.168.1.20:8004
