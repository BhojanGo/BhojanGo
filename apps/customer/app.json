{
  "expo": {
    "name": "BhojanGo",
    "slug": "bhojango",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bhojango.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "BhojanGo uses your location to find nearby restaurants and track your delivery.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "BhojanGo uses your location for real-time delivery tracking."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B5D66"
      },
      "package": "com.bhojango.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0B5D66"
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "BhojanGo uses the camera for a photo when you report a problem with an order.",
          "photosPermission": "BhojanGo lets you choose a photo when you report a problem with an order."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F4F6F6"
        }
      ]
    ],
    "scheme": "bhojango",
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    },
    "backgroundColor": "#F4F6F6"
  }
}
