# Copy to .env (git-ignored). The app calls the services directly (no gateway).
# Android emulator: keep localhost and forward the ports to your computer with
#   adb -s emulator-5554 reverse tcp:8001 tcp:8001   (and 8004, 8006, 8081)
# A phone on Wi-Fi: use your computer's LAN IP instead.
EXPO_PUBLIC_CORE_URL=http://localhost:8001
EXPO_PUBLIC_REALTIME_URL=http://localhost:8004
EXPO_PUBLIC_WORKER_URL=http://localhost:8006
