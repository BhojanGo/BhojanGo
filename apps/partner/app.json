{
  "expo": {
    "name": "BhojanGo Kitchen",
    "slug": "bhojango-partner",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.bhojango.partner",
      "infoPlist": {
        "NSCameraUsageDescription": "BhojanGo Kitchen uses the camera to take photos of your dishes for your menu.",
        "NSPhotoLibraryUsageDescription": "BhojanGo Kitchen lets you choose photos of your dishes for your menu."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B5D66"
      },
      "package": "com.bhojango.partner",
      "permissions": [
        "CAMERA",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "WAKE_LOCK"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BhojanGo Kitchen lets you choose photos of your dishes for your menu.",
          "cameraPermission": "BhojanGo Kitchen uses the camera to take photos of your dishes for your menu.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0B5D66"
        }
      ],
      "expo-secure-store",
      "expo-screen-orientation",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B5D66"
        }
      ]
    ],
    "scheme": "bhojango-partner",
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
