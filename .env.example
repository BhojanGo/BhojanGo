# =============================================================================
# BhojanGo — Environment Variables
# Copy this file to .env and fill in all values before running locally.
# NEVER commit .env to version control.
# =============================================================================

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
ENVIRONMENT=development
APP_VERSION=0.1.0

# ── Database (shared PostgreSQL, per-service schemas) ─────────────────────────
# Docker Compose uses a single DB with schemas per service
DATABASE_URL=postgresql+asyncpg://bhojango:bhojango_dev@localhost:5432/bhojango

# ── Redis ─────────────────────────────────────────────────────────────────────
# Each service uses a different Redis DB (0-5)
REDIS_URL=redis://localhost:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ── AWS Cognito ───────────────────────────────────────────────────────────────
AWS_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
AWS_COGNITO_CLIENT_ID=your-cognito-client-id
AWS_COGNITO_CLIENT_SECRET=your-cognito-client-secret

# ── AWS SQS / SNS ────────────────────────────────────────────────────────────
# LocalStack in dev: http://localhost:4566
SNS_ENDPOINT_URL=http://localhost:4566
SQS_ENDPOINT_URL=http://localhost:4566
ORDER_EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:bhojango-order-events
PAYMENT_EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:bhojango-payment-events
NOTIFICATION_QUEUE_URL=http://localhost:4566/000000000000/bhojango-notifications
ORDER_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/bhojango-order-events

# ── DynamoDB ──────────────────────────────────────────────────────────────────
DYNAMODB_ENDPOINT_URL=http://localhost:8000

# ── OpenSearch ────────────────────────────────────────────────────────────────
OPENSEARCH_URL=http://localhost:9200

# ── S3 ────────────────────────────────────────────────────────────────────────
S3_ENDPOINT_URL=http://localhost:4566
S3_BUCKET=bhojango-uploads
AWS_CLOUDFRONT_URL=https://d123456789.cloudfront.net

# ── Stripe (USA) ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ── Razorpay (India) ─────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── Twilio (SMS / OTP) ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_PHONE_NUMBER_IN=+911234567890

# ── Firebase FCM (Push Notifications) ────────────────────────────────────────
FIREBASE_PROJECT_ID=bhojango-app
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@bhojango-app.iam.gserviceaccount.com

# ── SendGrid (Email) ─────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@bhojango.com
SENDGRID_FROM_NAME=BhojanGo

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Apple Sign-In ────────────────────────────────────────────────────────────
APPLE_CLIENT_ID=com.bhojango.app
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_KEY_ID=XXXXXXXXXX
APPLE_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n"

# ── Google Maps ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_MAPS_SERVER_API_KEY=your_google_maps_server_api_key

# ── AWS Location Service ─────────────────────────────────────────────────────
AWS_LOCATION_PLACE_INDEX=bhojango-place-index
AWS_LOCATION_ROUTE_CALCULATOR=bhojango-route-calculator

# ── Next.js Web App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8888
NEXT_PUBLIC_WS_URL=ws://localhost:8004
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# ── Admin Dashboard ──────────────────────────────────────────────────────────
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# ── Kong API Gateway ─────────────────────────────────────────────────────────
KONG_PROXY_PORT=8888
KONG_ADMIN_PORT=8444

# ── Service Ports ────────────────────────────────────────────────────────────
USER_SVC_PORT=8001
RESTAURANT_SVC_PORT=8002
ORDER_SVC_PORT=8003
DELIVERY_SVC_PORT=8004
PAYMENT_SVC_PORT=8005
NOTIFICATION_SVC_PORT=8006

# ── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ── Internal service URLs (Docker Compose networking) ────────────────────────
# These are auto-configured in docker-compose.yml. Only set for bare-metal dev.
USER_SVC_URL=http://localhost:8001
RESTAURANT_SVC_URL=http://localhost:8002
ORDER_SVC_URL=http://localhost:8003
DELIVERY_SVC_URL=http://localhost:8004
PAYMENT_SVC_URL=http://localhost:8005
NOTIFICATION_SVC_URL=http://localhost:8006
