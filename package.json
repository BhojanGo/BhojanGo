{
  "name": "bhojango",
  "version": "0.1.0",
  "private": true,
  "description": "BhojanGo — Production-ready food delivery platform for USA & India",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky",
    "brand:assets": "node tools/brand/generate-assets.mjs"
  },
  "devDependencies": {
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "sharp": "0.35.5",
    "turbo": "^2.1.3",
    "typescript": "^5.4.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.1.4",
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom@<0.8.15": "^0.8.15",
      "brace-expansion@<1.1.20": "^1.1.20",
      "brace-expansion@>=2.0.0 <2.1.2": "^2.1.2",
      "browserslist@<4.28.7": "^4.28.7",
      "compression@<1.8.2": "^1.8.2",
      "decode-uri-component@<0.5.1": "^0.5.1",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "glob@>=10.2.0 <10.5.0": "^10.5.0",
      "joi@>=17.1.1 <17.13.9": "^17.13.9",
      "js-yaml@>=3.0.0 <3.15.2": "^3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "nanoid@>=3.0.0 <3.3.18": "^3.3.18",
      "node-forge@<1.4.1": "^1.4.1",
      "postcss@>=8.0.0 <8.5.18": "^8.5.18",
      "shell-quote@<1.9.0": "^1.9.0",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
      "ws@>=6.0.0 <6.2.4": "^6.2.4",
      "ws@>=7.0.0 <7.5.11": "^7.5.11",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "zod@>=4.0.0 <4.6.6": "^4.6.6"
    }
  }
}
