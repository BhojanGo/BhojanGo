{
  "name": "@bhojango/ui",
  "version": "0.1.0",
  "private": true,
  "description": "BhojanGo design system for the web: tokens, Tailwind preset, components (P16)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./tokens": {
      "types": "./tokens.d.ts",
      "default": "./tokens.js"
    },
    "./bill": {
      "types": "./bill.d.ts",
      "default": "./bill.js"
    },
    "./tailwind-preset": "./tailwind-preset.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external react",
    "dev": "tsup src/index.ts --format cjs,esm --dts --external react --watch",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no eslint config — skipping'",
    "clean": "rm -rf dist",
    "test": "node --test test/bill.test.js"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@bhojango/config": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.3.0"
  },
  "files": [
    "dist",
    "tokens.js",
    "tokens.d.ts",
    "bill.js",
    "bill.d.ts",
    "tailwind-preset.js"
  ]
}
