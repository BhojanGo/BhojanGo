{
  "name": "@bhojango/ui",
  "version": "0.1.0",
  "private": true,
  "description": "BhojanGo design system for the web: tokens, Tailwind preset, components (P16)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./tokens": {
      "types": "./tokens.d.ts",
      "default": "./tokens.js"
    },
    "./bill": {
      "types": "./bill.d.ts",
      "default": "./bill.js"
    },
    "./markdown": {
      "types": "./markdown.d.ts",
      "default": "./markdown.js"
    },
    "./legal-markdown": {
      "types": "./legal-markdown.d.ts",
      "default": "./legal-markdown.js"
    },
    "./environment": {
      "types": "./environment.d.ts",
      "default": "./environment.js"
    },
    "./tailwind-preset": "./tailwind-preset.js",
    "./security-headers": {
      "types": "./security-headers.d.ts",
      "default": "./security-headers.js"
    },
    "./statement": {
      "types": "./statement.d.ts",
      "default": "./statement.js"
    },
    "./reorder": {
      "types": "./reorder.d.ts",
      "default": "./reorder.js"
    },
    "./order-status": {
      "types": "./order-status.d.ts",
      "default": "./order-status.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external react",
    "dev": "tsup src/index.ts --format cjs,esm --dts --external react --watch",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no eslint config — skipping'",
    "clean": "rm -rf dist",
    "test": "node --test test/bill.test.js test/environment.test.js test/type.test.js test/markdown.test.js test/legal-markdown.test.js test/security-headers.test.js test/statement.test.js test/reorder.test.js test/billSum.test.js test/order-status.test.js"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@bhojango/config": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.3.0"
  },
  "files": [
    "dist",
    "tokens.js",
    "tokens.d.ts",
    "bill.js",
    "bill.d.ts",
    "environment.js",
    "markdown.js",
    "markdown.d.ts",
    "environment.d.ts",
    "tailwind-preset.js",
    "security-headers.js",
    "security-headers.d.ts",
    "legal-markdown.js",
    "legal-markdown.d.ts",
    "statement.js",
    "statement.d.ts",
    "reorder.js",
    "reorder.d.ts",
    "order-status.js",
    "order-status.d.ts"
  ]
}
