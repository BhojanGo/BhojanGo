                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Open Sos",
        "tags": [
          "Dispatch"
        ]
      }
    },
    "/api/v1/drivers/me/earnings/estimate": {
      "post": {
        "description": "Compute a full earnings breakdown (floor pay, mileage, waiting, tips, batch bonus, net).",
