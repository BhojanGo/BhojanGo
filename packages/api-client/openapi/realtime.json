          "mileage_payout",
          "order_bonus",
          "floor_guarantee",
          "floor_topup",
          "tips",
          "gross_earnings",
          "deductions",
          "net_earnings"
        ],
        "title": "EarningsBreakdownResponse",
        "type": "object"
      },
      "EarningsEstimateRequest": {
        "properties": {
          "active_minutes": {
            "minimum": 0.0,
            "title": "Active Minutes",
            "type": "integer"
          },
          "available_minutes": {
            "minimum": 0.0,
            "title": "Available Minutes",
            "type": "integer"
          },
          "deductions": {
            "default": 0,
            "minimum": 0.0,
            "title": "Deductions",
            "type": "number"
          },
          "miles": {
            "default": 0,
            "minimum": 0.0,
            "title": "Miles",
            "type": "number"
          },
          "num_orders": {
            "default": 1,
            "minimum": 0.0,
            "title": "Num Orders",
            "type": "integer"
          },
          "tips": {
            "default": 0,
            "minimum": 0.0,
            "title": "Tips",
