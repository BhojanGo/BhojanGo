          },
          "deductions": {
            "title": "Deductions",
            "type": "number"
          },
          "engaged_minutes": {
            "title": "Engaged Minutes",
            "type": "integer"
          },
          "floor_guarantee": {
            "title": "Floor Guarantee",
            "type": "number"
          },
          "floor_topup": {
            "title": "Floor Topup",
            "type": "number"
          },
          "gross_earnings": {
            "title": "Gross Earnings",
            "type": "number"
          },
          "mileage_payout": {
            "title": "Mileage Payout",
            "type": "number"
          },
          "miles": {
            "title": "Miles",
            "type": "number"
          },
          "net_earnings": {
            "title": "Net Earnings",
            "type": "number"
          },
          "num_orders": {
            "title": "Num Orders",
            "type": "integer"
          },
          "order_bonus": {
            "title": "Order Bonus",
            "type": "number"
          },
          "tips": {
