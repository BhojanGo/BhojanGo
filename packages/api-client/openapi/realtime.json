  "info": {
    "description": "Real-time GPS tracking, WebSockets, and ETA calculation",
    "title": "BhojanGo \u2014 Delivery Service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/delivery/assign": {
      "post": {
        "description": "Manual dispatch: an admin with dispatch.edit for the order's city gives it to a rider.",
        "operationId": "assign_driver_api_v1_delivery_assign_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeliveryAssignRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Assign Driver Api V1 Delivery Assign Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Assign Driver",
        "tags": [
          "Delivery"
        ]
      }
    },
    "/api/v1/delivery/driver/active-order": {
      "get": {
        "operationId": "get_driver_active_order_api_v1_delivery_driver_active_order_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Driver Active Order Api V1 Delivery Driver Active Order Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Get Driver Active Order",
        "tags": [
          "Delivery"
        ]
      }
    },
    "/api/v1/delivery/driver/location": {
      "post": {
        "description": "A rider's GPS fix (every few seconds while online). Goes to the order\nthey are delivering, never to one they aren't assigned to.",
        "operationId": "update_driver_location_api_v1_delivery_driver_location_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DriverLocationUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DriverLocationResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Update Driver Location",
        "tags": [
          "Delivery"
        ]
      }
    },
    "/api/v1/delivery/{order_id}/eta": {
      "get": {
        "description": "Minutes to pickup and drop-off from the rider's last position.",
        "operationId": "get_order_eta_api_v1_delivery__order_id__eta_get",
        "parameters": [
          {
            "in": "path",
            "name": "order_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Order Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EtaResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Get Order Eta",
        "tags": [
          "Delivery"
        ]
      }
    },
    "/api/v1/dispatch/shadow-batches": {
      "get": {
        "description": "Batches the shadow batcher would have made (nothing is batched): dispatch admins.",
        "operationId": "shadow_batches_api_v1_dispatch_shadow_batches_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 500,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response Shadow Batches Api V1 Dispatch Shadow Batches Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "summary": "Shadow Batches",
        "tags": [
          "Dispatch"
        ]
      }
    },
    "/api/v1/dispatch/sos": {
      "get": {
        "description": "Open SOS alerts in the cities the admin dispatches for.",
