{
  "name": "@bhojango/batch-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Batch Delivery Engine — groups nearby orders for efficient multi-stop delivery",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "migrate": "psql $DATABASE_URL -f src/db/migrations/001_create_batch_tables.sql"
  },
  "dependencies": {
    "@aws-sdk/client-sns": "^3.600.0",
    "@aws-sdk/client-sqs": "^3.600.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/tests"],
    "moduleNameMapper": {
      "^../src/(.*)$": "<rootDir>/src/$1"
    }
  }
}
